(version 1)
(deny default)

(deny process-fork)
(allow process-exec
    (subpath "{codex_prefix}")
    (subpath "{virtualenv_path}")
    (literal "{real_python_exe}")
    (subpath "{real_python_prefix}")
    (subpath "{real_base_prefix}")
)

(allow sysctl-read)
(allow mach-lookup)

; Allow /dev/null for stdout redirect in candidate_runner.py
(allow file-read*  (literal "/dev/null"))
(allow file-write* (literal "/dev/null"))
(allow file-ioctl  (literal "/dev/null"))

(allow file-read*
    (literal "/")
    (subpath "/System")
    (subpath "/usr")
    (subpath "/Library")
    (subpath "{codex_prefix}")
    (subpath "{virtualenv_path}")
    (subpath "{real_python_prefix}")
    (subpath "{real_base_prefix}")
    (literal "{real_python_exe}")
    (literal "{repository_root}/candidate_runner.py")
    (subpath "{candidate_dir}")
    (subpath "{temp_dir}")
)

(allow file-read-metadata)

(allow file-write*
    (subpath "{temp_dir}")
)
