(version 1)
(deny default)

(allow process-fork)
(allow process-exec)
(allow sysctl-read)
(allow mach-lookup)
(allow network-outbound)

(allow file-read*
    (literal "/")
    (subpath "/System")
    (subpath "/usr")
    (subpath "/Library")
    (subpath "{codex_base_dir}")
    (subpath "{codex_prefix}")
    (literal "/private/etc/resolv.conf")
    (subpath "/private/etc/ssl")
    (subpath "/etc")
    (literal "{user_home}/.CFUserTextEncoding")
    (subpath "{real_temp_home}")
    (subpath "{real_candidate_input_dir}")
)

(allow file-read-metadata)

(allow file-write*
    (subpath "{real_temp_home}")
)
